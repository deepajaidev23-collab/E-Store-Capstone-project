# Bibliophile — environment variables
# Copy this file to .env.local and fill in your values.
#
# SECURITY: Never commit .env.local to source control.
#   .env.local is covered by *.local in .gitignore.
#   Verify with: git ls-files .env.local  (should return nothing)
#   If a key is ever accidentally committed, rotate it immediately in the
#   Supabase dashboard: Settings → API → Rotate anon key.
#
# This file (.env.example) is safe to commit — it contains no real values.

# ── Supabase project ──────────────────────────────────────────────────────────
# Found in: Supabase dashboard → Project Settings → API

# Your project's REST API URL
VITE_SUPABASE_URL=

# Anon/public key — safe to expose in browser bundles (relies on RLS for security)
VITE_SUPABASE_ANON_KEY=

# ── Repository backend ────────────────────────────────────────────────────────
# Set to "true" to use the live Supabase backend.
# Leave unset (or "false") to use mock repositories — all tests pass without
# a live Supabase project.
VITE_USE_SUPABASE=false
